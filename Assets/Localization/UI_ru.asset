  - m_Id: 8878425941991424
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028488196096
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043D\u0430\u0442\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608128
    m_Localized: "\u041D\u0443\u0436\u043D\u044B \u043F\u043B\u043E\u0442\u043D\u043E\u0435
      \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u0443\u0440\u043E\u043D: \u043F\u0440\u043E\u0440\u0432\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u0432\u0440\u0430\u0433\u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044E\u0442
      \u0431\u0430\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608129
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u043D\u0430\u0442\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608130
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0434\u0430\u0442\u044C
      \u0436\u0438\u0432\u0443\u0447\u0438\u043C \u0432\u0440\u0430\u0433\u0430\u043C
      \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C \u043E\u0431\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608131
    m_Localized: "\u0420\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C
      \u0431\u0430\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608132
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u044C \u0441\u0438\u043B\u044C\u043D\u044B\u0439
      firing lane \u0438 burst-\u0443\u0440\u043E\u043D: \u044D\u0442\u043E\u0442
      \u0432\u0440\u0430\u0433 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u043F\u0430\u0441\u0435\u043D
      \u0434\u043B\u044F \u0431\u0430\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608133
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0432\u043E\u043B\u043D\u0430
      {0}: \u0432\u0440\u0430\u0433\u043E\u0432 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608134
    m_Localized: "{0}x {1} \u2014 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608135
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0432\u043E\u043B\u043D\u0430
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608136
    m_Localized: "\u0412\u043E\u043B\u043D\u0430 {0}/{1} \u2014 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435:
      {2}/{3}"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608137
    m_Localized: "\u0412\u043E\u043B\u043D\u0430 {0}/{1} \u2014 \u0432\u0440\u0430\u0433\u043E\u0432
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 105480028626608138
    m_Localized: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043A
      \u0432\u043E\u043B\u043D\u0435 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 105482538066108416
    m_Localized: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 105482538091274240
    m_Localized: "\u0414\u0435\u0448\u0451\u0432\u0430\u044F \u0431\u0430\u0448\u043D\u044F
      \u0434\u043B\u044F \u0440\u0430\u043D\u043D\u0435\u0439 \u043B\u0438\u043D\u0438\u0438
      \u0438 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 105482538091274241
    m_Localized: "\u0417\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 105482538091274242
    m_Localized: "\u0421\u0442\u0430\u0432\u044C \u0432 \u043F\u043B\u043E\u0442\u043D\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442: \u0443\u0440\u043E\u043D \u043F\u043E
      \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0433\u0440\u0443\u043F\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 105482538091274243
    m_Localized: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u044E\u0449\u0438\u0439\u0441\u044F
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 105482538091274244
    m_Localized: "\u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439, \u0437\u0430\u0442\u043E
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043F\u043E\u0442\u043E\u043B\u043E\u043A \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 105501076893982720
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0434\u043D\u0443
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 105501076944314368
    m_Localized: "\u0417\u0430\u043F\u0430\u0441 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432\n+5
      \u0432\u0430\u043B\u044E\u0442\u044B \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 105501076944314369
    m_Localized: "\u0410\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442\n+10
      HP \u0431\u0430\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 105501076944314370
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430 \u0434\u043E\u0431\u044B\u0447\u0443\n+15
      \u043A \u043D\u0430\u0433\u0440\u0430\u0434\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
